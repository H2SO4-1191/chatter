<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomDatePickerTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/black</item>
        <item name="android:datePickerDialogTheme">@style/CustomDatePickerDialog</item>
    </style>
    <style name="CustomDatePickerDialog" parent="android:Widget.Material.DatePicker">
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="SplashScreenTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Set the background color or drawable for the splash screen -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:background">@drawable/c_logo</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
    </style>
</resources>
