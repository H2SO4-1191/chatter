<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="15dp"
    android:background="@drawable/input_field"
    android:animateLayoutChanges="true">

    <androidx.cardview.widget.CardView
        android:id="@+id/senderProfilePictureFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#00000000"
        app:cardCornerRadius="100dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@id/messageCell"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/messageCell"
        app:layout_constraintVertical_bias="1">
        <ImageView
            android:id="@+id/senderProfilePicture"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_horizontal"
            android:foregroundTint="#000000"
            android:scaleType="centerCrop"
            android:src="@drawable/c_logo"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/toast_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Pop-up"
        android:fontFamily="@font/alike_angular"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@android:color/white" />
</LinearLayout>
