<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chatter_home_background"
    tools:context=".activities.SignupActivity">

    <TextView
        android:id="@+id/hello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="40dp"
        android:fontFamily="@font/aguafina_script"
        android:text="@string/hello_new_chatter"
        android:textAlignment="center"
        android:gravity="center"
        android:textColor="@color/seriousYellow"
        android:textSize="48dp"
        app:layout_constraintBottom_toTopOf="@+id/fullNameField"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintVertical_chainStyle="packed" />

    <EditText
        android:id="@+id/birth"
        android:layout_width="250dp"
        android:layout_height="40dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/input_field"
        android:focusable="false"
        android:ems="10"
        android:fontFamily="sans-serif-medium"
        android:hint="@string/birth"
        android:paddingStart="10dp"
        android:singleLine="true"
        android:textColor="@color/seriousYellow"
        android:textColorHint="@color/white"
        android:textSize="16dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/maleButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirmPasswordField"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/phoneNumberField"
        android:layout_width="250dp"
        android:layout_height="40dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/input_field"
        android:ems="10"
        android:fontFamily="sans-serif-medium"
        android:hint="@string/phone_number"
        android:inputType="phone"
        android:paddingStart="10dp"
        android:paddingEnd="50dp"
        android:singleLine="true"
        android:textColor="#FFB703"
        android:textColorHint="@color/white"
        android:textSize="16dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/passwordField"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emailField"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/passwordField"
        android:layout_width="250dp"
        android:layout_height="40dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/input_field"
        android:ems="10"
        android:fontFamily="sans-serif-medium"
        android:hint="@string/password"
        android:inputType="textPassword"
        android:paddingStart="10dp"
        android:paddingEnd="50dp"
        android:singleLine="true"
        android:textColor="#FFB703"
        android:textColorHint="@color/white"
        android:textSize="16dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/confirmPasswordField"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phoneNumberField"
        tools:visibility="visible" />

    <ToggleButton
        android:id="@+id/maleButton"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginEnd="25dp"
        android:background="@drawable/male_switch"
        android:fontFamily="@font/alike_angular"
        android:foregroundGravity="center_vertical"
        android:text="@string/m"
        android:textAlignment="center"
        android:textColor="#4cc9f0"
        android:textOff="@string/m"
        android:textOn="@string/m"
        android:textSize="24dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/femaleButton"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/birth"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/userNameField"
        android:layout_width="250dp"
        android:layout_height="40dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/input_field"
        android:ems="10"
        android:fontFamily="sans-serif-medium"
        android:hint="@string/username"
        android:inputType="text"
        android:paddingStart="10dp"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:textColor="@color/seriousYellow"
        android:textColorHint="@color/white"
        android:textSize="16dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/emailField"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fullNameField"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/fullNameField"
        android:layout_width="250dp"
        android:layout_height="40dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/input_field"
        android:ems="10"
        android:fontFamily="sans-serif-medium"
        android:hint="@string/first_amp_last_name"
        android:inputType="text"
        android:paddingStart="10dp"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:textColor="@color/seriousYellow"
        android:textColorHint="@color/white"
        android:textSize="16dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/userNameField"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hello"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/confirmPasswordField"
        android:layout_width="250dp"
        android:layout_height="40dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/input_field"
        android:ems="10"
        android:fontFamily="sans-serif-medium"
        android:hint="@string/confirm_password"
        android:inputType="textPassword"
        android:paddingStart="10dp"
        android:paddingEnd="50dp"
        android:singleLine="true"
        android:textColor="@color/seriousYellow"
        android:textColorHint="@color/white"
        android:textSize="16dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/birth"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/passwordField"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/emailField"
        android:layout_width="250dp"
        android:layout_height="40dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/input_field"
        android:ems="10"
        android:fontFamily="sans-serif-medium"
        android:hint="@string/email"
        android:inputType="textEmailAddress"
        android:paddingStart="10dp"
        android:singleLine="true"
        android:textColor="#FFB703"
        android:textColorHint="@color/white"
        android:textSize="16dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/phoneNumberField"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/userNameField"
        tools:visibility="visible" />

    <Button
        android:id="@+id/pen"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@null"
        android:foreground="@drawable/baseline_edit_24"
        android:foregroundTint="@color/seriousYellow"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hello"
        app:layout_constraintVertical_bias="1.0" />

    <ToggleButton
        android:id="@+id/femaleButton"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginStart="25dp"
        android:background="@drawable/female_switch"
        android:fontFamily="@font/alike_angular"
        android:text="@string/f"
        android:textAlignment="center"
        android:textColor="#ff006e"
        android:textOff="@string/f"
        android:textOn="@string/f"
        android:textSize="24dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/maleButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/maleButton"
        app:layout_constraintTop_toTopOf="@+id/maleButton"
        app:layout_constraintVertical_bias="1.0"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/fly"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.075"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hello"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/drop"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/fullNameField"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hello" />

    <TextView
        android:id="@+id/gap"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/userNameField"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fullNameField" />

    <androidx.cardview.widget.CardView
        android:id="@+id/picContainer"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:cardCornerRadius="50dp"
        app:cardBackgroundColor="#00000000"
        app:layout_constraintStart_toStartOf="@id/progressBar"
        app:layout_constraintEnd_toEndOf="@id/progressBar"
        app:layout_constraintTop_toTopOf="@id/progressBar"
        app:layout_constraintBottom_toBottomOf="@id/progressBar">

        <ImageView
            android:id="@+id/profilePicture"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@null"
            android:backgroundTint="@null"
            android:foregroundTint="@color/seriousYellow"
            android:scaleType="centerCrop"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/picContainer"
            app:layout_constraintEnd_toEndOf="@+id/picContainer"
            app:layout_constraintStart_toStartOf="@+id/picContainer"
            app:layout_constraintTop_toTopOf="@+id/picContainer"
            tools:foreground="@drawable/baseline_account_circle_24"
            tools:visibility="visible" />

    </androidx.cardview.widget.CardView>

    <Spinner
        android:id="@+id/countryCode"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:dropDownWidth="100dp"
        android:dropDownSelector="@drawable/input_field"
        android:foreground="@android:drawable/ic_dialog_map"
        android:foregroundTint="@color/seriousYellow"
        android:popupBackground="@drawable/spinner_background"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/phoneNumberField"
        app:layout_constraintEnd_toEndOf="@+id/phoneNumberField"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toStartOf="@+id/phoneNumberField"
        app:layout_constraintTop_toTopOf="@+id/phoneNumberField"
        tools:visibility="visible" />

    <Button
        android:id="@+id/showPassword"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@null"
        android:foreground="@android:drawable/ic_menu_view"
        android:foregroundTint="@color/seriousYellow"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/passwordField"
        app:layout_constraintEnd_toEndOf="@+id/passwordField"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toStartOf="@+id/passwordField"
        app:layout_constraintTop_toTopOf="@+id/passwordField"
        tools:visibility="visible" />

    <Button
        android:id="@+id/showConfirmPassword"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@null"
        android:foreground="@android:drawable/ic_menu_view"
        android:foregroundTint="@color/seriousYellow"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/confirmPasswordField"
        app:layout_constraintEnd_toEndOf="@+id/confirmPasswordField"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toStartOf="@+id/confirmPasswordField"
        app:layout_constraintTop_toTopOf="@+id/confirmPasswordField"
        tools:visibility="visible" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginTop="24dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/seriousYellowAlpha"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/maleButton"
        app:layout_constraintVertical_bias="0.0"
        tools:visibility="visible" />

    <ProgressBar
        android:id="@+id/checkingUsername"
        style="?android:attr/progressBarStyle"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/seriousYellowAlpha"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/userNameField"
        app:layout_constraintStart_toEndOf="@+id/userNameField"
        app:layout_constraintTop_toTopOf="@+id/userNameField"
        tools:visibility="visible" />

    <ProgressBar
        android:id="@+id/checkingPhoneNumber"
        style="?android:attr/progressBarStyle"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/seriousYellowAlpha"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/phoneNumberField"
        app:layout_constraintStart_toEndOf="@+id/phoneNumberField"
        app:layout_constraintTop_toTopOf="@+id/phoneNumberField"
        tools:visibility="visible" />

    <ProgressBar
        android:id="@+id/checkingEmail"
        style="?android:attr/progressBarStyle"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/seriousYellowAlpha"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/emailField"
        app:layout_constraintStart_toEndOf="@+id/emailField"
        app:layout_constraintTop_toTopOf="@+id/emailField"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>