<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_4"
    tools:context=".activities.ProfileActivity">

    <Button
        android:id="@+id/doButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@null"
        android:foreground="@drawable/baseline_edit_document_24"
        android:foregroundTint="@color/seriousYellow"
        app:layout_constraintBottom_toBottomOf="@+id/border"
        app:layout_constraintEnd_toEndOf="@id/border"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/border"
        app:layout_constraintTop_toTopOf="@id/border"
        app:layout_constraintVertical_bias="0.0"
        android:visibility="invisible"
        tools:visibility="visible"/>

    <ImageView
        android:id="@+id/border"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/accountInfoContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/chatter_banner" />

    <ProgressBar
        android:id="@+id/loadingAccount"
        android:layout_width="100dp"
        android:layout_height="0dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/seriousYellow"
        app:layout_constraintBottom_toBottomOf="@+id/border"
        app:layout_constraintEnd_toEndOf="@id/border"
        app:layout_constraintStart_toStartOf="@id/border"
        app:layout_constraintTop_toTopOf="@id/border" />

    <ScrollView
        android:id="@+id/accountInfoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/doButton"
        android:visibility="invisible"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="#00000000"
                app:cardCornerRadius="20dp">

                <ImageView
                    android:id="@+id/profilePictureAccount"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:foregroundTint="#000000"
                    android:scaleType="fitXY"

                    tools:srcCompat="@drawable/baseline_account_circle_24" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/usernameAccountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/alike_angular"
                android:gravity="center_horizontal"
                android:text="@string/username"
                android:textColor="@color/seriousYellow"
                android:textSize="18sp"
                android:textStyle="italic" />

            <EditText
                android:id="@+id/usernameAccountField"
                android:layout_width="300dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@drawable/input_field"
                android:ems="10"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:inputType="text"
                android:padding="10dp"
                android:singleLine="true"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/fullNameAccountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/alike_angular"
                android:gravity="center_horizontal"
                android:text="@string/first_amp_last_name"
                android:textColor="@color/seriousYellow"
                android:textSize="18sp"
                android:textStyle="italic" />

            <EditText
                android:id="@+id/fullNameAccountField"
                android:layout_width="300dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@drawable/input_field"
                android:ems="10"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:padding="10dp"
                android:singleLine="true"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/emailAccountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/alike_angular"
                android:gravity="center_horizontal"
                android:text="@string/email"
                android:textColor="@color/seriousYellow"
                android:textSize="18sp"
                android:textStyle="italic" />

            <EditText
                android:id="@+id/emailAccountField"
                android:layout_width="300dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@drawable/input_field"
                android:ems="10"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:inputType="textEmailAddress"
                android:padding="10dp"
                android:singleLine="true"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/phoneNumberAccountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/alike_angular"
                android:gravity="center_horizontal"
                android:text="@string/phone_number"
                android:textColor="@color/seriousYellow"
                android:textSize="18sp"
                android:textStyle="italic" />

            <EditText
                android:id="@+id/phoneNumberAccountField"
                android:layout_width="300dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@drawable/input_field"
                android:ems="10"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:inputType="phone"
                android:padding="10dp"
                android:singleLine="true"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/passwordAccountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/alike_angular"
                android:gravity="center_horizontal"
                android:text="@string/password"
                android:textColor="@color/seriousYellow"
                android:textSize="18sp"
                android:textStyle="italic" />

            <EditText
                android:id="@+id/passwordAccountField"
                android:layout_width="300dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@drawable/input_field"
                android:ems="10"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:inputType="textPassword"
                android:padding="10dp"
                android:singleLine="true"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/birthAccountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/alike_angular"
                android:gravity="center_horizontal"
                android:text="@string/birth"
                android:textColor="@color/seriousYellow"
                android:textSize="18sp"
                android:textStyle="italic" />

            <EditText
                android:id="@+id/birthAccountField"
                android:layout_width="300dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@drawable/input_field"
                android:ems="10"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:inputType="text"
                android:padding="10dp"
                android:singleLine="true"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/genderAccountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/alike_angular"
                android:gravity="center_horizontal"
                android:text="@string/gender"
                android:textColor="@color/seriousYellow"
                android:textSize="18sp"
                android:textStyle="italic" />

            <EditText
                android:id="@+id/genderAccountField"
                android:layout_width="300dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@drawable/input_field"
                android:ems="10"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:inputType="text"
                android:padding="10dp"
                android:singleLine="true"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/addedChattersText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/alike_angular"
                    android:text="@string/chats_with"
                    android:textColor="@color/seriousYellow"
                    android:textSize="18sp"
                    android:textStyle="italic" />

                <ProgressBar
                    android:id="@+id/loadingAdded"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/seriousYellow"
                    android:visibility="invisible"
                    tools:visibility="visible" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/addedChatters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/changePasswordInclude"
        layout="@layout/change_password_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>